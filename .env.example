# Frontend build-time variables (Vite). Copy to .env.local (dev) or
# .env.production (build). Never commit the real files.

# ── Branding ────────────────────────────────────────────────────────────────
VITE_APP_NAME=Mailcow Webmail
VITE_ORG_NAME=
VITE_LOGIN_TAGLINE=Masuk ke webmail Anda
# Helpdesk address for the "reset password" link on login errors (empty = hidden)
VITE_SUPPORT_EMAIL=
# Domain used by the email-settings help link when no user is logged in
VITE_DEFAULT_MAIL_DOMAIN=

# ── SOGo / API ──────────────────────────────────────────────────────────────
# Leave empty when the SPA is served from the same origin as SOGo (recommended).
VITE_SOGO_BASE_URL=
# Comma-separated hostnames that serve SOGo (images from these hosts are
# treated as internal and are not routed through the image proxy).
VITE_SOGO_KNOWN_HOSTS=mail.example.com
# Must equal API_KEY of the backend proxy. NOTE: this value is embedded in the
# browser bundle — it is an abuse speed bump, not a secret. See SECURITY.md.
VITE_API_KEY=replace-with-random-string

# ── Development only ────────────────────────────────────────────────────────
# Dev proxy targets: /SOGo goes to VITE_SOGO_BASE_URL (or mail.example.com);
# /api goes to VITE_API_PROXY_TARGET (default: local server.js on :3001)
VITE_API_PROXY_TARGET=
# Account shown in the dev-only quick-fill button (empty = hidden)
VITE_DEV_LOGIN_HINT=
