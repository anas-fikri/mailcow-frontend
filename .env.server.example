# Backend proxy (server.js) runtime configuration.
# Copy to the service's .env (e.g. ~/sogo-proxy/.env). Never commit the real file.

PORT=3005
NODE_ENV=production

# Shared secret checked on every /api request (X-Api-Key). Generate with:
#   openssl rand -hex 32
API_KEY=

# Allowed browser origins (comma-separated)
CORS_ORIGINS=https://mail.example.com
# Reverse-proxy IPs whose X-Real-IP header is trusted for rate limiting
TRUSTED_PROXY_IPS=
# Set to false only for local HTTP development
COOKIE_SECURE=true

# ── SMTP (sending) ──────────────────────────────────────────────────────────
SMTP_HOST=mail.example.com
SMTP_PORT=465
# Optional path to an extra CA certificate
SMTP_TLS_CA=
SMTP_SESSION_IDLE_MIN=30
SMTP_SESSION_TTL_MIN=480
SMTP_SESSION_MAX_PER_USER=10
SMTP_MAX_ATTACHMENT_MB=
SMTP_MAX_TOTAL_MB=
SMTP_MAX_ATTACHMENTS=
# Undo-send window and send-queue persistence
SMTP_SEND_UNDO_SECONDS=180
SMTP_SEND_FLUSH_MS=5000
SMTP_SEND_MAX_HORIZON_MS=
SEND_QUEUE_FILE=
# Defaults to API_KEY when empty
SEND_QUEUE_SECRET=

# ── IMAP (server-side copy to Sent) ─────────────────────────────────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_SENT_MAILBOXES=Sent,INBOX/Sent,Sent Messages
SENT_COPY_DISABLED=false

# ── mailcow MySQL (user preferences) ────────────────────────────────────────
MYSQL_CONTAINER=mailcow-mysql-mailcow-1
DB_HOST=
DB_PORT=3306
DBUSER=mailcow
DBPASS=
DBNAME=mailcow
