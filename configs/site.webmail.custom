# site.webmail.custom - SOGo React Frontend
location /webmail {
    root /web;
    index index.html;
    try_files $uri $uri/ /webmail/index.html;

    location ~* \.html$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        expires -1;
    }

    location ~* \.(css|js|woff2?|svg|gif|png|jpe?g|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}

# SMTP proxy backend (server.js di host; port khusus SOGo, bukan Control Tower)
location ~ ^/api/(send|health|preferences|auth/smtp)$ {
    proxy_pass http://172.25.1.1:3005;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
}
