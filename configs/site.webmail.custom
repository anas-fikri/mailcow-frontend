# site.webmail.custom - SOGo React Frontend
# CSP: SPA murni tanpa inline script; email-body pakai inline style (unsafe-inline style)
# dan Google Fonts. connect-src 'self' cukup karena SOGo & /api dilayani origin yang sama.
# img-src TIDAK memuat https: — semua gambar eksternal email di-rewrite ke
# /api/image-proxy (anti tracking-pixel); mengizinkan https: langsung akan
# membuka jalur pixel tanpa proxy.
# HSTS tanpa includeSubDomains: hanya host ini yang dijamin HTTPS (subdomain lain
# belum tentu HTTPS — includeSubDomains bisa memutus aksesnya).
location /webmail {
    root /web;
    index index.html;
    try_files $uri $uri/ /webmail/index.html;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; object-src 'none'; frame-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "0" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;

    location ~* \.html$ {
        # expires -1 DIHAPUS: menghasilkan Cache-Control: no-cache + Expires
        # terpisah → duplikat dgn add_header Cache-Control di bawah (no-store,
        # no-cache, must-revalidate sudah cukup utk HTML SPA; dua nilai berbeda
        # membingungkan parser header).
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; object-src 'none'; frame-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-XSS-Protection "0" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    # sw.js & theme-init.js NON-hash (nama tetap tiap deploy) — TIDAK boleh
    # di-cache immutable seperti asset ber-hash: SW harus bisa update & inisialisasi
    # tema harus segar. manifest.webmanifest juga no-cache (mudah diubah).
    # Pisahkan .js (sw, theme-init) dari .webmanifest agar nginx auto-detect
    # MIME type yang benar. Sebelumnya types{}+default_type menimpa semua ke
    # application/octet-stream → browser refuse execute script (strict MIME).
    location ~* (^|/)(sw\.js|theme-init\.js)$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; object-src 'none'; frame-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-XSS-Protection "0" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    location ~* (^|/)manifest\.webmanifest$ {
        types { application/manifest+json webmanifest; }
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location ~* \.(css|js|woff2?|svg|gif|png|jpe?g|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; object-src 'none'; frame-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-XSS-Protection "0" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }
}

# SMTP proxy backend (server.js di host; port khusus SOGo, bukan other apps).
# Exact locations must win over broader /api regex routes of other apps.
# ── Konflik header level-server mailcow (sites-default.conf.j2) ──
# Level-server meng-inherit X-Frame-Options SAMEORIGIN + HSTS 15768000 (6 bln)
# ke semua location TANPA add_header sendiri → konflik dgn server.js (DENY/1th).
# Solusi: (1) proxy_hide_header menghapus header dari upstream server.js supaya
# tidak duplikat; (2) add_header di sini menetapkan SATU nilai konsisten.
# Cache-Control TIDAK di-set ulang — server.js sudah set no-store utk data
# sensitif & public immutable utk image-proxy.
location = /api/health {
    proxy_pass http://172.25.1.1:3005;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
}
