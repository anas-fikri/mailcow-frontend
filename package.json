{
  "name": "sogo-frontend",
  "version": "1.0.0",
  "description": "PCP Express Modern Webmail \u2014 SOGo React Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server.js",
    "dev:all": "concurrently -k -n \"SMTP,VITE\" -c \"bgBlue,bgGreen\" \"node server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "test:safe-url": "node scripts/test-safe-url.mjs",
    "test:user-prefs": "node scripts/test-user-prefs.mjs",
    "test:path-segment": "node scripts/test-path-segment.mjs",
    "test:message-totals": "node scripts/test-message-totals.mjs",
    "test:message-rows": "node scripts/test-message-rows.mjs",
    "test:message-requests": "node scripts/test-message-requests.mjs",
    "test:message-api": "node scripts/test-message-api.mjs",
    "test:nginx-routes": "node scripts/test-nginx-routes.mjs",
    "test:login-diagnostics": "node scripts/test-login-diagnostics.mjs",
    "test:login-flow": "node scripts/test-login-flow.mjs",
    "test:initials": "node scripts/test-initials.mjs",
    "test:preferences-fallback": "node scripts/test-preferences-fallback.mjs",
    "test:progress-percent": "node scripts/test-progress-percent.mjs",
    "test:mailbox-tree": "node scripts/test-mailbox-tree.mjs",
    "test:message-html": "node scripts/test-message-html.mjs",
    "test:email-category": "node scripts/test-email-category.mjs",
    "test:signatures": "node scripts/test-signatures.mjs",
    "test:draft-api": "node scripts/test-draft-api.mjs",
    "test:snooze": "node scripts/test-snooze.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.0.0",
    "cors": "^2.8.6",
    "dompurify": "^3.4.12",
    "express": "^5.2.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
