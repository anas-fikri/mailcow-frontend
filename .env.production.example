# Production build variables (copy to .env.production; never commit the real file)
# Kosongkan (same-origin) — SPA & SOGo dilayani nginx yang sama utk semua vhost
# (mail.pcpexpress.co.id & mail.pcpexpress.com). Isi hanya jika SPA di origin terpisah.
VITE_SOGO_BASE_URL=
# Must match API_KEY in /home/anas.fikri/sogo-proxy/.env on mailserver.
VITE_API_KEY=replace-with-production-api-key

# deploy.sh can read API_KEY from mailserver automatically when VITE_API_KEY is not set locally.
# The static frontend necessarily embeds this value in its browser bundle for /api authentication.
